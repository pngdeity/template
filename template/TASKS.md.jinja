uv run pytest
{%- elif lang == 'javascript' or lang == 'typescript' -%}
{{ node_test_cmd }}
{%- elif lang == 'go' -%}
go test ./...
{%- elif lang == 'rust' -%}
cargo test
{%- elif lang == 'dotnet' -%}
dotnet test
{%- endif %}{% if not loop.last %} && {% endif %}{% endfor %}{% if not languages %}echo replace-me{% endif %}`
