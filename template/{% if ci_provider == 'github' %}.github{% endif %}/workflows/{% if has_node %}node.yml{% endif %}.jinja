name: Node

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
{% if node_runtime == 'deno' %}
      - uses: denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed # v2
      - run: deno fmt --check && deno lint
{% else %}
{% include 'template/_partials/node-ci-setup.jinja' %}
      - run: {{ node_lint_cmd }}
{% if has_node_build %}
      - run: npx tsc --noEmit
{% endif %}
{% endif %}

  test:
    runs-on: ubuntu-latest
    needs: lint
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
{% if node_runtime == 'deno' %}
      - uses: denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed # v2
      - run: deno test
{% else %}
{% include 'template/_partials/node-ci-setup.jinja' %}
      - run: {{ node_test_cmd }}
{% endif %}
