name: Node

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{% if node_runtime == 'deno' and node_lint == 'biome' %}
      - uses: denoland/setup-deno@v2
      - uses: actions/setup-node@v4
        with:
          node-version: {{ node_version }}
      - run: npm ci
      - run: npx biome check .
{% elif node_runtime == 'deno' %}
      - uses: denoland/setup-deno@v2
      - run: deno fmt --check && deno lint
{% else %}
{% set node_setup_deno = (node_lint == 'deno' and node_runtime != 'bun') %}
{% include 'template/_partials/node-ci-setup.jinja' %}
      - run: {{ node_lint_cmd }}
{% if has_node_build %}
      - run: npx tsc --noEmit
{% endif %}
{% endif %}

  test:
    runs-on: ubuntu-latest
    needs: lint
    steps:
      - uses: actions/checkout@v4
{% if node_runtime == 'deno' %}
      - uses: denoland/setup-deno@v2
      - run: deno test
{% else %}
{% include 'template/_partials/node-ci-setup.jinja' %}
      - run: {{ node_test_cmd }}
{% endif %}
