name: Python

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: astral-sh/setup-uv@d4b2f3b6ecc6e67c4457f6d3e41ec42d3d0fcb86 # v5
      - run: uv sync
      - run: uv run ruff check . && uv run ruff format --check .
{% if python_scaffolding == 'application' %}
      - run: uv run mypy src/
{% endif %}

  test:
    runs-on: ubuntu-latest
    needs: lint
    strategy:
      matrix:
        python-version: ["{{ python_version }}", "3.{{ (python_version.split('.')[1] | int + 1) }}", "3.{{ (python_version.split('.')[1] | int + 2) }}"]
      fail-fast: false
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: astral-sh/setup-uv@d4b2f3b6ecc6e67c4457f6d3e41ec42d3d0fcb86 # v5
        with:
          python-version: ${{ '{{' }} matrix.python-version {{ '}}' }}
      - run: uv sync
      - run: uv run pytest
