name: APM Audit

on:
  pull_request:
    paths:
      - apm.yml
      - apm.lock.yaml
      - .apm/**
      - .github/**
      - .claude/**
      - .cursor/**
      - .opencode/**

jobs:
  audit:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Install & audit
        id: apm
        uses: microsoft/apm-action@d723bb64ed70c135bbaf87d126b721dd2dae0439 # v1
        with:
          audit-report: true
        env:
          GITHUB_APM_PAT: ${{ secrets.APM_PAT }}
      - if: always() && steps.apm.outputs.audit-report-path
        uses: github/codeql-action/upload-sarif@4bfa242aa49c5f7c6770b98670d354a7dfac05f8 # v3
        with:
          sarif_file: ${{ steps.apm.outputs.audit-report-path }}
          category: apm-audit
