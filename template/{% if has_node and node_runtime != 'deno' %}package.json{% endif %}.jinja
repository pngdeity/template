{% set npm_license = license_type %}
{% if license_type == 'GPL-3.0' %}{% set npm_license = 'GPL-3.0-only' %}{% endif %}
{% if license_type == 'proprietary' %}{% set npm_license = 'UNLICENSED' %}{% endif %}
{% set gh_slug = github_username if github_username else (author_name | lower | replace(' ', '-')) %}
{% if not gh_slug %}{% set gh_slug = 'OWNER-CHANGEME' %}{% endif %}
{% set build_entry = 'dist/index.js' %}
{% set build_index = 'dist/index.d.ts' %}
{
  "name": "{{ repo_name }}",
  "version": "0.1.0",
{% if is_node_library %}
  "private": false,
{% elif is_node_plugin %}
  "private": false,
{% else %}
  "private": true,
{% endif %}
  "type": "module",
  "description": "{{ repo_description }}",
  "license": "{{ npm_license }}",
{% if author_name %}
  "author": "{{ author_name }}{% if author_email %} <{{ author_email }}>{% endif %}",
{% endif %}
{% set keyword_list = (['opencode-plugin'] if is_node_plugin else []) + (node_keywords or []) %}
{% if keyword_list %}
  "keywords": [{{ '' }}
{% for kw in keyword_list %}
    "{{ kw | trim }}"{% if not loop.last %},{% endif %}{{ "\n" | trim }}
{% endfor %}
  ],
{% endif %}
{% if node_peer_dependencies %}
  "peerDependencies": {
{% for dep, version in node_peer_dependencies.items() %}
    "{{ dep }}": "{{ version }}"{% if not loop.last %},{% endif %}{{ "\n" | trim }}
{% endfor %}
  },
{% endif %}
{% if is_node_plugin %}
  "sideEffects": false,
{% if node_build == 'none' %}
  "files": [
    "server.ts",
    "tui.ts",
    "src",
    "!**/*.test.ts"
  ],
  "exports": {
    "./server": "./server.ts",
    "./tui": "./tui.ts"
  },
  "engines": {
    "node": ">={{ node_version }}",
    "opencode": ">=2.0.0"
  },
{% else %}
  "files": [
    "server.js",
    "tui.js",
    "dist"
  ],
  "main": "./{{ build_entry }}",
  "types": "./{{ build_index }}",
  "exports": {
    ".": {
      "types": "./{{ build_index }}",
      "import": "./{{ build_entry }}"
    },
    "./server": "./server.js",
    "./tui": "./tui.js"
  },
  "engines": {
    "node": ">={{ node_version }}",
    "opencode": ">=2.0.0"
  },
{% endif %}
{% elif is_node_library %}
  "sideEffects": false,
{% if node_build == 'none' %}
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
{% else %}
  "files": [
    "dist",
    "!**/*.test.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
{% endif %}
  "exports": {
    ".": {
{% if node_build == 'none' %}
      "types": "./src/index.ts",
      "import": "./src/index.ts"
{% else %}
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
{% endif %}
    }{% for sub in node_subpath_exports or [] %},
    "./{{ sub | trim }}": {
{% if node_build == 'none' %}
      "types": "./src/{{ sub | trim }}.ts",
      "import": "./src/{{ sub | trim }}.ts"
{% else %}
      "types": "./dist/{{ sub | trim }}.d.ts",
      "import": "./dist/{{ sub | trim }}.js"
{% endif %}
    }{% endfor %}{{ '' }}
  },
  "engines": {
    "node": ">={{ node_version }}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{ gh_slug }}/{{ repo_name }}.git"
  },
  "homepage": "https://github.com/{{ gh_slug }}/{{ repo_name }}#readme",
  "bugs": {
    "url": "https://github.com/{{ gh_slug }}/{{ repo_name }}/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
{% endif %}
  "scripts": {
    "test": "{{ node_test_runner }}"{% if has_node_build %},
    "build": "{{ node_build_cmd }}",
    "typecheck": "tsc --noEmit"{% endif %}{% if is_node_publishable %},
    "prepack": "{% if has_node_build %}{{ node_build_cmd }} && {% endif %}{{ node_test_cmd }}"{% endif %}
  }{% if node_lint == 'biome' %},
  "devDependencies": {
    "@biomejs/biome": "^2.0.0"{% if has_node_build %},
    "typescript": "^5.9.0"{% endif %}
  }{% elif has_node_build %},
  "devDependencies": {
    "typescript": "^5.9.0"{% if node_build == 'tsup' %},
    "tsup": "^8.0.0"{% endif %}
  }{% endif %}{{ '' }}
}

